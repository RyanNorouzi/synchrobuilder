{
  "version": 1,
  "audit": {
    "ignore": [
      "examples/demo-repo/**",
      "tests/**",
      "docs/research/**",
      "site/dist/**",
      "plugins/synchrobuilder/lib/audit/rules/**",
      "plugins/synchrobuilder/lib/fix/**"
    ]
  },
  "contracts": {
